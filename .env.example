# Postgres. In production, use a Neon (https://neon.tech) free-tier project —
# a real Postgres connection is required because Cloudflare Workers'
# filesystem is ephemeral (SQLite would lose the daily snapshot job's
# writes). For local dev you can point both at any local Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5432/cardstory_dev"
# Neon also exposes a separate *unpooled* connection string — Prisma Migrate
# needs a direct (non-pgbouncer) connection. Locally this can be identical
# to DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/cardstory_dev"

# aistudio.google.com free-tier key. Powers the Scan feature's card
# identification. If unset, Scan gracefully falls back to manual search.
GEMINI_API_KEY=

# Random secret checked by /api/cron/snapshot-prices before running the
# daily price-snapshot job. Generate with: openssl rand -hex 32
CRON_SECRET=

# Signs/encrypts NextAuth's session JWTs. Generate with: npx auth secret
# (or: openssl rand -base64 32). Required — auth breaks without it.
AUTH_SECRET=

# Optional — raises pokemontcg.io's free rate limit. Not required.
POKEMONTCG_API_KEY=

# Optional, PAID — pricecharting.com/api-documentation. Powers the card
# detail page's "Graded Prices" panel (real PSA/CGC/SGC/BGS grade prices).
# No free tier exists; get your own key from a PriceCharting subscription.
# If unset, the panel shows a "not configured" note instead of erroring.
PRICECHARTING_API_KEY=

# Optional, PAID — sportscardspro.com/api-documentation, PriceCharting's
# sister site for sports cards (NBA/F1/UFC/Tennis). Same API shape, same
# 1 req/sec limit, billed separately. Powers the Add Sports Card dialog's
# search (auto-fills the exact parallel + a real price). Falls back to
# PRICECHARTING_API_KEY if unset, in case your subscription covers both.
# Without either, sports cards can still be added fully manually.
SPORTSCARDSPRO_API_KEY=

# Used to build absolute Showcase share links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Powers the card detail page's "eBay Sold Comps" panel — parses eBay's
# public sold/completed-listings search results (there is no official eBay
# API for this outside restricted partner programs). This SCRAPES eBay
# rather than calling an official API, which is against eBay's terms of
# service and fragile (breaks whenever eBay changes its result-page HTML),
# so it's off by default. Set to "true" to opt in.
EBAY_SOLD_COMPS_ENABLED=

# Optional — overrides the User-Agent header sent when scraping eBay.
EBAY_SCRAPE_USER_AGENT=
