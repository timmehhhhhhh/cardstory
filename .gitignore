# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (the .example template is intentionally tracked)
.env*
!.env.example

# raw crawl logs — large, regenerable, and the derived mapping files under
# scripts/data/card-images/ are what actually get reviewed and committed
scripts/.cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare (opennextjs-cloudflare build output / local wrangler state / generated types)
.open-next/
.wrangler/
cloudflare-env.d.ts
