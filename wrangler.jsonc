{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Matches the script name Cloudflare already created for this repo's
  // Workers Builds git integration ("cardstory" — see the build/deploy
  // URLs on the "Workers Builds: cardstory" GitHub check). Changing this
  // would make Cloudflare treat it as a different Worker.
  "name": "cardstory",
  // The Workers Builds git integration's dashboard "Build command" MUST be
  // `npx opennextjs-cloudflare build` — that's what actually produces this
  // file; plain `npm run build` only runs `next build` and stops (see the
  // "build"/"preview"/"deploy" scripts in package.json). Left as `npm run
  // build` for a while, which built the Next.js app fine but always failed
  // at deploy with "entry-point file … was not found" once wrangler went
  // looking for a worker.js that was never generated. After fixing that
  // dashboard setting, the very next build still ran the old command —
  // Workers Builds' "Build cache" toggle (Settings → Build) had to be
  // cleared once for the corrected command to actually take effect.
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-22",
  // `.open-next/worker.js` is already a fully bundled, minified output from
  // `opennextjs-cloudflare build` — `wrangler deploy` re-bundles it once
  // more through its own esbuild pass regardless, and defaults keepNames to
  // true when this is unset. That injects `__name(fn, "fn")` calls into
  // every function body, including next-themes' theme-init function — which
  // next-themes inlines client-side as a raw <script> tag by calling
  // `.toString()` on it at runtime. Function.prototype.toString() returns
  // the POST-transform source, so the shipped snippet references `__name`
  // without the helper (which lives in wrangler's bundle scope, not in the
  // extracted function text) — the browser then throws "__name is not
  // defined" on every page load, before hydration completes. `false` here
  // stops esbuild from injecting those calls in the first place.
  "keep_names": false,
  // Required by @opennextjs/cloudflare — Next.js's server runtime uses
  // Node.js APIs (Prisma, bcryptjs, cheerio, ...) that only exist under
  // this compatibility flag.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Backs open-next.config.ts's KV incremental cache, persisting Next's
  // data/route cache (unstable_cache, fetch cache, ISR) across requests and
  // isolates. Binding name is hardcoded by @opennextjs/cloudflare's
  // kv-incremental-cache override — do not rename. Namespace already
  // existed in Cloudflare from before this was first tried; re-bound here
  // now that the Workers Paid plan's 10 MiB gzip cap gives the bundle
  // headroom (was 3 MiB on the free plan — see git history on this file).
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "c06d7548c14b446a9c1cf562df011599"
    }
  ],
  // Backs open-next.config.ts's Durable Object-sharded tag cache — without
  // this, revalidateTag()/revalidatePath() have nowhere to record "this tag
  // is stale" on Cloudflare (unlike local `next dev`, whose built-in cache
  // tracks tags natively), so calls to them silently no-op in production.
  // Binding name is hardcoded by @opennextjs/cloudflare's
  // do-sharded-tag-cache override — do not rename. The DOShardedTagCache
  // class itself is generated into .open-next/worker.js by `opennextjs-
  // cloudflare build`, not written by hand in this repo.
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOShardedTagCache"]
    }
  ],
  // Non-sensitive only — DATABASE_URL, AUTH_SECRET, and the other API keys
  // from .env.example must be set as Worker *secrets* instead (Cloudflare
  // dashboard → Worker → Settings → Variables and Secrets, or
  // `wrangler secret put <NAME>`), since this file is committed.
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://cardstory.app"
  }
}
