// CardStory data model.
//
// This database holds the shared card catalog, its real price history, and
// — for signed-in users — accounts and portfolios. Accounts are optional:
// a logged-out visitor's portfolio still lives entirely in the browser's
// localStorage (see src/lib/portfolio/local-store.ts). Signing in switches
// portfolio reads/writes to the Portfolio/Holding tables below (see
// src/lib/portfolio/store.ts, the switcher). ShowcaseSnapshot predates
// accounts and keeps working the same way for anonymous publishers: a
// deliberate, explicit "publish" action copies a point-in-time snapshot of
// holdings into this DB so it can be shared via a public link, authorized
// by a client-held ownerToken rather than a session.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GameStatus {
  WIRED
  COMING_SOON
}

enum ProductType {
  CARD
  SEALED
}

enum Sport {
  NBA
  F1
  UFC
  TENNIS
}

model Game {
  id           String        @id
  name         String
  logoUrl      String
  status       GameStatus    @default(COMING_SOON)
  sortOrder    Int           @default(0)
  sets         Set[]
  catalogItems CatalogItem[]

  @@map("games")
}

model Set {
  id          String        @id
  gameId      String
  game        Game          @relation(fields: [gameId], references: [id])
  name        String
  code        String
  releaseDate DateTime?
  symbolUrl   String?
  cardCount   Int?
  items       CatalogItem[]

  @@index([gameId])
  @@map("sets")
}

model CatalogItem {
  id             String           @id
  gameId         String
  game           Game             @relation(fields: [gameId], references: [id])
  setId          String
  set            Set              @relation(fields: [setId], references: [id])
  externalId     String
  name           String
  number         String?
  rarity         String?
  /// Illustrator credit, e.g. Pokémon's "Mitsuhiro Arita". Only populated for
  /// games whose API credits an artist per card — currently Pokémon and FAB.
  artist         String?
  /// Game-specific card type, e.g. Riftbound's "Champion Unit" / "Legend" /
  /// "Gear" / "Signature Spell" (a printed type + supertype combo — see
  /// lib/games/riftbound/card-types.ts). Null for games that don't have a
  /// distinct card-type taxonomy wired up yet.
  cardType       String?
  imageSmallUrl  String?
  imageLargeUrl  String?
  productType    ProductType      @default(CARD)
  language       String           @default("EN")
  lastSyncedAt   DateTime         @updatedAt
  priceSnapshots PriceSnapshot[]
  gradedPriceSnapshots GradedPriceSnapshot[]

  /// Denormalized cache of the latest PriceSnapshot, kept in sync by
  /// upsertPriceSnapshot() whenever a new snapshot is written. Exists so
  /// Explore/Movers/sort-by-price can be plain indexed Prisma queries
  /// instead of a per-request "latest snapshot per item" join.
  latestPriceRaw   Decimal? @db.Decimal(10, 2)
  latestPriceFoil  Decimal? @db.Decimal(10, 2)
  latestPriceDate  String?
  prevPriceRaw     Decimal? @db.Decimal(10, 2)
  priceChangePct   Float?

  /// PriceCharting's own product id for this card, cached the first time we
  /// resolve it via a `q=` search so later lookups can go straight to
  /// `/api/product?id=` — matters because PriceCharting rate-limits to 1
  /// request/second, so avoiding repeat searches is not optional.
  priceChartingId String?

  @@unique([gameId, externalId])
  @@index([setId])
  @@index([name])
  @@index([cardType])
  @@index([rarity])
  @@index([latestPriceRaw])
  @@index([priceChangePct])
  @@map("catalog_items")
}

model PriceSnapshot {
  id            String      @id @default(cuid())
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])
  capturedAt    DateTime    @default(now())
  /// "YYYY-MM-DD" — the idempotency key for the daily job (one row/item/day).
  capturedDate  String
  currency      String      @default("USD")
  priceRaw      Decimal?    @db.Decimal(10, 2)
  priceFoil     Decimal?    @db.Decimal(10, 2)
  /// "pokemontcg.io" | "scryfall"
  source        String

  @@unique([catalogItemId, capturedDate])
  @@index([catalogItemId, capturedAt])
  @@map("price_snapshots")
}

/// Real graded-condition prices from PriceCharting's Prices API — an
/// optional, paid, official API (not scraping). PriceCharting itself only
/// exposes CURRENT values ("Historic prices and historic sales are not
/// supported" per their docs), so — same as PriceSnapshot — we snapshot
/// once per day per card to build real history ourselves rather than
/// fabricate a backfill. Fetched on-demand (from the card detail page),
/// not via a bulk job, because PriceCharting rate-limits to 1 request/sec
/// which makes bulk-syncing the whole catalog impractical.
model GradedPriceSnapshot {
  id            String      @id @default(cuid())
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])
  capturedAt    DateTime    @default(now())
  /// "YYYY-MM-DD" — idempotency key, same pattern as PriceSnapshot.
  capturedDate  String
  currency      String      @default("USD")

  /// PriceCharting's own ungraded reference price — kept separately from
  /// CatalogItem.latestPriceRaw (our primary raw-price source) rather than
  /// overwriting it; shown as a cross-reference, not a replacement.
  loosePrice  Decimal? @db.Decimal(10, 2)
  grade7Price  Decimal? @db.Decimal(10, 2) // PriceCharting "cib-price": graded 7-7.5
  grade8Price  Decimal? @db.Decimal(10, 2) // "new-price": graded 8-8.5
  grade9Price  Decimal? @db.Decimal(10, 2) // "graded-price": graded 9
  grade95Price Decimal? @db.Decimal(10, 2) // "box-only-price": graded 9.5
  psa10Price   Decimal? @db.Decimal(10, 2) // "manual-only-price": PSA 10 specifically
  cgc10Price   Decimal? @db.Decimal(10, 2) // "condition-17-price"
  sgc10Price   Decimal? @db.Decimal(10, 2) // "condition-18-price"
  bgs10Price   Decimal? @db.Decimal(10, 2) // "bgs-10-price"
  source       String   @default("pricecharting")

  @@unique([catalogItemId, capturedDate])
  @@index([catalogItemId, capturedAt])
  @@map("graded_price_snapshots")
}

/// A sports card *type* (sport + set + player + parallel) — analogous to
/// CatalogItem for TCGs. Unlike CatalogItem, there's no free browsable
/// catalog for sports cards, so rows here are created on demand: either
/// matched against SportsCardsPro's real product catalog (which already
/// distinguishes parallels, e.g. "Base" vs "Prizm Silver" vs "Optic Holo"
/// as separate products) or entered fully manually.
///
/// Deliberately does NOT carry a serial number — that's which specific
/// numbered copy of a parallel a collector owns (e.g. "23" of a "/99"),
/// which is ownership information and lives on the local-only Holding
/// (src/lib/portfolio/types.ts), the same way gradeCompany/gradeValue do.
model SportsCardItem {
  id           String   @id @default(cuid())
  sport        Sport
  /// Always displayed/stored together as "[year] [distributor] [setName]",
  /// e.g. "2020 Panini Mosaic" — kept as three separate fields (rather than
  /// one free-text set name) specifically so that order is structural, not
  /// dependent on how a user happens to type it.
  year         Int?
  /// The manufacturer, e.g. "Panini", "Topps", "Upper Deck".
  distributor  String?
  /// Just the product line name, e.g. "Mosaic", "Prizm", "Chrome" — NOT
  /// prefixed with year/distributor; see the note above.
  setName      String
  /// The product line's actual street date (e.g. "2021-02-02" for 2020-21
  /// Panini Prizm Basketball), shared by every card/parallel in that
  /// product — same "one date per product, not per card" shape as
  /// Set.releaseDate for TCGs. Null when no confidently-sourced date was
  /// found (see scripts/data/lamelo-ball/release-dates.ts).
  releaseDate  DateTime?
  playerName   String
  teamName     String?
  cardNumber   String?
  /// null/"" = base card. e.g. "Prizm Silver", "Optic Holo", "Ruby Wave".
  parallelName String?
  isAutograph  Boolean  @default(false)
  isRelic      Boolean  @default(false)
  /// The print run this parallel is numbered to, e.g. "99", or "1" for a
  /// 1-of-1 — a property of the parallel itself (SportsCardsPro's catalog
  /// encodes it in the product name). NOT the specific copy owned; see
  /// Holding.serialNumber for that.
  serialLimit  String?
  imageUrl     String?
  /// Back-of-card image, same "external reference link" convention as
  /// imageUrl — only ever a URL, never a re-hosted/uploaded copy for
  /// checklist-seeded rows (see cardType below). Rare in practice: card
  /// backs are seldom photographed except for graded high-end cards.
  imageBackUrl String?
  /// Where imageUrl/imageBackUrl/the card's existence was verified, for
  /// attribution and so a user can double-check a checklist-seeded row.
  sourceUrl    String?
  /// "base" | "insert" | "short_print" — set only on rows created by a
  /// checklist seed script (e.g. scripts/seed-lamelo-ball.ts), on EVERY
  /// row belonging to that checklist including each parallel (parallels
  /// are siblings sharing year/distributor/setName/cardNumber/cardType,
  /// distinguished by parallelName — same "one row per parallel" model
  /// the rest of this table already uses; see note above). Null for
  /// every card a user adds ad hoc via AddSportsCardDialog.
  cardType     String?
  /// Deterministic natural key computed at seed time (sport|year|
  /// distributor|setName|playerName|cardNumber|parallelName, lowercased),
  /// so re-running a checklist seed script upserts instead of duplicating.
  /// Null for ad hoc user-added cards, which have no such key.
  externalKey  String?  @unique
  createdAt    DateTime @default(now())

  /// SportsCardsPro's product id, cached once resolved via search so later
  /// refreshes go straight to id lookup — same rate-limit reasoning as
  /// CatalogItem.priceChartingId. Null for cards entered fully manually
  /// with no confident catalog match (no live pricing until one is found).
  priceChartingId String? @unique

  /// Denormalized cache of the latest snapshot's ungraded price, same
  /// pattern as CatalogItem, so Portfolio totals are plain indexed reads.
  latestPriceRaw  Decimal? @db.Decimal(10, 2)
  latestPriceDate String?
  prevPriceRaw    Decimal? @db.Decimal(10, 2)
  priceChangePct  Float?

  priceSnapshots SportsCardPriceSnapshot[]

  @@index([sport])
  @@index([playerName])
  @@index([cardType])
  @@map("sports_card_items")
}

/// Same "current value only, snapshot once/day ourselves" pattern as
/// GradedPriceSnapshot — SportsCardsPro (PriceCharting's sister site for
/// sports cards, same API/account family) also only exposes current
/// values, not history.
model SportsCardPriceSnapshot {
  id               String         @id @default(cuid())
  sportsCardItemId String
  sportsCardItem   SportsCardItem @relation(fields: [sportsCardItemId], references: [id])
  capturedAt       DateTime       @default(now())
  capturedDate     String
  currency         String         @default("USD")

  loosePrice   Decimal? @db.Decimal(10, 2)
  grade7Price  Decimal? @db.Decimal(10, 2)
  grade8Price  Decimal? @db.Decimal(10, 2)
  grade9Price  Decimal? @db.Decimal(10, 2)
  grade95Price Decimal? @db.Decimal(10, 2)
  psa10Price   Decimal? @db.Decimal(10, 2)
  cgc10Price   Decimal? @db.Decimal(10, 2)
  sgc10Price   Decimal? @db.Decimal(10, 2)
  bgs10Price   Decimal? @db.Decimal(10, 2)
  source       String   @default("sportscardspro")

  @@unique([sportsCardItemId, capturedDate])
  @@index([sportsCardItemId, capturedAt])
  @@map("sports_card_price_snapshots")
}

model ShowcaseSnapshot {
  id         String   @id @default(cuid())
  /// Kept only in the publishing browser's localStorage; the credential
  /// that authorizes updating/deleting this snapshot for anonymous
  /// publishers. Still written (and still authoritative) even when userId
  /// is also set, so a snapshot published while logged in remains editable
  /// from the same browser without requiring a session.
  ownerToken String
  /// Set when the publisher was signed in at publish time. Optional and
  /// SetNull on user deletion — this snapshot is a point-in-time copy, not
  /// a live view of the user's portfolio, so it should outlive the account.
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  /// Serialized holdings + computed totals at publish time.
  payload    Json

  @@index([userId])
  @@map("showcase_snapshots")
}

/// An account. Only Credentials (email + password) auth exists today, so
/// there's no Account/Session/VerificationToken adapter tables — NextAuth
/// is configured with JWT sessions, which need no DB-backed session state.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  portfolios        Portfolio[]
  showcaseSnapshots ShowcaseSnapshot[]

  @@map("users")
}

/// Server-backed portfolio for a signed-in user — the accounts equivalent
/// of the local-only Portfolio shape in src/lib/portfolio/types.ts. Holding
/// ids are still generated client-side (see src/lib/portfolio/remote-store.ts)
/// so `id` has a server default but accepts a client-supplied value on create.
model Portfolio {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  holdings  Holding[]

  @@index([userId])
  @@map("portfolios")
}

/// Server-backed equivalent of the local Holding type. kind/condition/
/// language are plain strings (not Prisma enums) because the existing
/// lowercase TS unions ("tcg", "raw", "EN") are already used by every
/// portfolio-consuming component and by holdings already persisted in
/// users' localStorage — zod validates these at the API boundary instead.
/// catalogItemId/sportsCardItemId are plain scalars, not @relations: a
/// Holding populates exactly one depending on kind (not a single relation
/// Prisma can express), and holdings are already enriched via batch
/// lookups (/api/catalog/by-ids, /api/sportscards/by-ids), not joins —
/// same zero-referential-integrity behavior the local store has today.
model Holding {
  id                String    @id @default(cuid())
  portfolioId       String
  portfolio         Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  kind              String    @default("tcg")
  catalogItemId     String?
  sportsCardItemId  String?
  quantity          Int
  condition         String
  gradeCompany      String?
  gradeValue        String?
  serialNumber      String?
  language          String    @default("EN")
  costBasisTotal    Decimal   @db.Decimal(10, 2)
  costBasisCurrency String
  acquiredAt        DateTime
  notes             String?
  /// A photo of the specific physical card this holding represents — the
  /// owner's own copy, distinct from CatalogItem/SportsCardItem's shared
  /// reference image. Either an https:// URL or a client-resized JPEG data
  /// URL (see resizeImageToDataUrl), so plain text is enough.
  imageUrl          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([portfolioId])
  @@map("holdings")
}
