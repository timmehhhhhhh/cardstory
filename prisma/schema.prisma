// CardStory data model.
//
// This database holds the shared card catalog, its real price history,
// accounts, and portfolios. The app now requires a signed-in session for
// collection data, so portfolio reads/writes go through the Portfolio/Holding
// tables below (see src/lib/pc/store.ts and remote-store.ts). ShowcaseSnapshot
// keeps working as a public share surface: a deliberate, explicit "publish"
// action copies a point-in-time snapshot of holdings into this DB so it can be
// shared via a public link, authorized by a client-held ownerToken rather than
// a session.

// One client, generated to the default node_modules/.prisma/client. It emits
// both a Node build (index.js, native engine — used by local dev) and a WASM
// build (wasm.js + query_engine_bg.wasm) that Cloudflare Workers uses via the
// "@prisma/client/wasm" subpath export. See src/lib/db.ts for how the two are
// selected at runtime.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GameStatus {
  WIRED
  COMING_SOON
}

enum ProductType {
  CARD
  SEALED
}

enum Sport {
  NBA
  F1
  UFC
  TENNIS
}

model Game {
  id           String        @id
  name         String
  logoUrl      String
  status       GameStatus    @default(COMING_SOON)
  sortOrder    Int           @default(0)
  sets         Set[]
  catalogItems CatalogItem[]

  @@map("games")
}

model Set {
  id          String        @id
  gameId      String
  game        Game          @relation(fields: [gameId], references: [id])
  name        String
  /// English name for a non-English set, so e.g. a JP Pokémon set's
  /// "アビスアイ" is also shown as "Abyss Eye" — see
  /// scripts/data/pokemon-set-translations.ts. Null for English sets (their
  /// own `name` already is the English name) and for any non-English set
  /// whose English translation hasn't been identified yet. Mirrors
  /// CatalogItem.nameEn above.
  nameEn      String?
  code        String
  releaseDate DateTime?
  symbolUrl   String?
  logoUrl     String?
  cardCount   Int?
  items       CatalogItem[]

  @@index([gameId])
  @@index([nameEn])
  @@map("sets")
}

model CatalogItem {
  id                     String                  @id
  gameId                 String
  game                   Game                    @relation(fields: [gameId], references: [id])
  setId                  String
  set                    Set                     @relation(fields: [setId], references: [id])
  externalId             String
  /// Which priced finish/printing of `externalId` this row is, e.g.
  /// pokemontcg.io's "holofoil" / "reverseHolofoil" / "1stEditionHolofoil"
  /// (see lib/games/pokemon/mapper.ts). Defaults to "" for every non-Pokémon
  /// row (FAB/MTG/Riftbound all still collapse to one row per card), which
  /// keeps their uniqueness behavior byte-identical to before this column
  /// existed. Never null — Postgres treats NULL as distinct-from-everything
  /// in a unique index, which would silently stop enforcing "one row per
  /// externalId" for every game that doesn't use this field.
  variantKey             String                  @default("")
  name                   String
  /// English name for a non-English row, so e.g. a JP Pokémon card's
  /// "アルフの石版" is also searchable as "Alph Lithograph" — see
  /// lib/catalog/search.ts's `q` clause. Null for English rows (their own
  /// `name` already is the English name) and for any non-English row whose
  /// English counterpart hasn't been identified yet.
  nameEn                 String?
  number                 String?
  rarity                 String?
  /// Illustrator credit, e.g. Pokémon's "Mitsuhiro Arita". Only populated for
  /// games whose API credits an artist per card — currently Pokémon and FAB.
  artist                 String?
  /// Game-specific card type, e.g. Riftbound's "Champion Unit" / "Legend" /
  /// "Gear" / "Signature Spell" (a printed type + supertype combo — see
  /// lib/games/riftbound/card-types.ts). Null for games that don't have a
  /// distinct card-type taxonomy wired up yet.
  cardType               String?
  /// Riftbound's `classification.domain` — one or two of Fury/Calm/Mind/
  /// Body/Chaos/Order/Colorless (see lib/games/riftbound/domain.ts). A
  /// dual-domain Legend has two entries; every other game leaves this at
  /// its `[]` default (no domain concept).
  domain                 String[]                @default([])
  /// National Pokédex number(s) for a Pokémon-supertype card, e.g. [6] for
  /// Charizard, [133, 134] for a two-species combo/TAG TEAM card. Empty for
  /// every non-Pokémon row (Trainer/Energy/Supporter/Item cards, and every
  /// non-Pokémon game) — same "default-empty, not null" convention as
  /// `domain` above, so filtering/joins never special-case NULL.
  nationalPokedexNumbers Int[]                   @default([])
  imageSmallUrl          String?
  imageLargeUrl          String?
  productType            ProductType             @default(CARD)
  language               String                  @default("EN")
  lastSyncedAt           DateTime                @updatedAt
  priceSnapshots         PriceSnapshot[]
  gradedPriceSnapshots   GradedPriceSnapshot[]
  ebaySoldPriceSnapshots EbaySoldPriceSnapshot[]

  /// Denormalized cache of the latest PriceSnapshot, kept in sync by
  /// upsertPriceSnapshot() whenever a new snapshot is written. Exists so
  /// Explore/Movers/sort-by-price can be plain indexed Prisma queries
  /// instead of a per-request "latest snapshot per item" join.
  latestPriceRaw  Decimal? @db.Decimal(10, 2)
  latestPriceFoil Decimal? @db.Decimal(10, 2)
  latestPriceDate String?
  prevPriceRaw    Decimal? @db.Decimal(10, 2)
  priceChangePct  Float?

  /// PriceCharting's own product id for this card, cached the first time we
  /// resolve it via a `q=` search so later lookups can go straight to
  /// `/api/product?id=` — matters because PriceCharting rate-limits to 1
  /// request/second, so avoiding repeat searches is not optional.
  priceChartingId String?

  @@unique([gameId, externalId, variantKey])
  @@index([gameId, externalId])
  @@index([setId])
  @@index([name])
  @@index([nameEn])
  @@index([cardType])
  @@index([rarity])
  @@index([domain])
  @@index([nationalPokedexNumbers])
  @@index([latestPriceRaw])
  @@index([priceChangePct])
  @@map("catalog_items")
}

model PriceSnapshot {
  id            String      @id @default(cuid())
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])
  capturedAt    DateTime    @default(now())
  /// "YYYY-MM-DD" — the idempotency key for the daily job (one row/item/day).
  capturedDate  String
  currency      String      @default("USD")
  priceRaw      Decimal?    @db.Decimal(10, 2)
  priceFoil     Decimal?    @db.Decimal(10, 2)
  /// "pokemontcg.io" | "scryfall"
  source        String

  @@unique([catalogItemId, capturedDate])
  @@index([catalogItemId, capturedAt])
  @@map("price_snapshots")
}

/// Real graded-condition prices from PriceCharting's Prices API — an
/// optional, paid, official API (not scraping). PriceCharting itself only
/// exposes CURRENT values ("Historic prices and historic sales are not
/// supported" per their docs), so — same as PriceSnapshot — we snapshot
/// once per day per card to build real history ourselves rather than
/// fabricate a backfill. Fetched on-demand (from the card detail page),
/// not via a bulk job, because PriceCharting rate-limits to 1 request/sec
/// which makes bulk-syncing the whole catalog impractical.
model GradedPriceSnapshot {
  id            String      @id @default(cuid())
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])
  capturedAt    DateTime    @default(now())
  /// "YYYY-MM-DD" — idempotency key, same pattern as PriceSnapshot.
  capturedDate  String
  currency      String      @default("USD")

  /// PriceCharting's own ungraded reference price — kept separately from
  /// CatalogItem.latestPriceRaw (our primary raw-price source) rather than
  /// overwriting it; shown as a cross-reference, not a replacement.
  loosePrice   Decimal? @db.Decimal(10, 2)
  grade7Price  Decimal? @db.Decimal(10, 2) // PriceCharting "cib-price": graded 7-7.5
  grade8Price  Decimal? @db.Decimal(10, 2) // "new-price": graded 8-8.5
  grade9Price  Decimal? @db.Decimal(10, 2) // "graded-price": graded 9
  grade95Price Decimal? @db.Decimal(10, 2) // "box-only-price": graded 9.5
  psa10Price   Decimal? @db.Decimal(10, 2) // "manual-only-price": PSA 10 specifically
  cgc10Price   Decimal? @db.Decimal(10, 2) // "condition-17-price"
  sgc10Price   Decimal? @db.Decimal(10, 2) // "condition-18-price"
  bgs10Price   Decimal? @db.Decimal(10, 2) // "bgs-10-price"
  source       String   @default("pricecharting")

  @@unique([catalogItemId, capturedDate])
  @@index([catalogItemId, capturedAt])
  @@map("graded_price_snapshots")
}

/// Real sold-comp prices scraped from eBay's public "sold & completed
/// listings" search results — NOT an official eBay API (eBay doesn't expose
/// this data outside restricted partner programs). Kept as a separate
/// cross-reference table rather than folded into GradedPriceSnapshot: that
/// table's `source` column carries a single official-API provenance
/// ("pricecharting"), and scraped data shouldn't blur into that. Same
/// "current value only, snapshot once/day ourselves" reasoning as
/// GradedPriceSnapshot — one row per item per day, fetched on-demand from
/// the card detail page (see src/lib/pricing/ebay/), never a bulk job:
/// scraping the whole catalog daily would be a very large volume of
/// requests against a site with no scraping allowance.
model EbaySoldPriceSnapshot {
  id            String      @id @default(cuid())
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])
  capturedAt    DateTime    @default(now())
  /// "YYYY-MM-DD" — idempotency key, same pattern as PriceSnapshot.
  capturedDate  String
  currency      String      @default("USD")
  /// The search query actually sent to eBay — kept for audit/debugging,
  /// since scraped results are only as good as the query that produced them.
  query         String
  /// Number of sold listings the aggregate below is computed from, after
  /// outlier filtering. Zero means the query matched no confident comps.
  count         Int
  medianPrice   Decimal?    @db.Decimal(10, 2)
  avgPrice      Decimal?    @db.Decimal(10, 2)
  minPrice      Decimal?    @db.Decimal(10, 2)
  maxPrice      Decimal?    @db.Decimal(10, 2)
  source        String      @default("ebay-sold")

  @@unique([catalogItemId, capturedDate])
  @@index([catalogItemId, capturedAt])
  @@map("ebay_sold_price_snapshots")
}

/// A sports card *type* (sport + set + player + parallel) — analogous to
/// CatalogItem for TCGs. Unlike CatalogItem, there's no free browsable
/// catalog for sports cards, so rows here are created on demand: either
/// matched against SportsCardsPro's real product catalog (which already
/// distinguishes parallels, e.g. "Base" vs "Prizm Silver" vs "Optic Holo"
/// as separate products) or entered fully manually.
///
/// Deliberately does NOT carry a serial number — that's which specific
/// numbered copy of a parallel a collector owns (e.g. "23" of a "/99"),
/// which is ownership information and lives on the local-only Holding
/// (src/lib/portfolio/types.ts), the same way gradeCompany/gradeValue do.
model SportsCardItem {
  id               String    @id @default(cuid())
  sport            Sport
  /// Always displayed/stored together as "[year] [distributor] [setName]",
  /// e.g. "2020 Panini Mosaic" — kept as three separate fields (rather than
  /// one free-text set name) specifically so that order is structural, not
  /// dependent on how a user happens to type it.
  year             Int?
  /// The manufacturer, e.g. "Panini", "Topps", "Upper Deck".
  distributor      String?
  /// Just the product line name, e.g. "Mosaic", "Prizm", "Chrome" — NOT
  /// prefixed with year/distributor; see the note above.
  setName          String
  /// The product line's actual street date (e.g. "2021-02-02" for 2020-21
  /// Panini Prizm Basketball), shared by every card/parallel in that
  /// product — same "one date per product, not per card" shape as
  /// Set.releaseDate for TCGs. Null when no confidently-sourced date was
  /// found (see scripts/data/lamelo-ball/release-dates.ts).
  releaseDate      DateTime?
  playerName       String
  teamName         String?
  cardNumber       String?
  /// null/"" = base card. e.g. "Prizm Silver", "Optic Holo", "Ruby Wave".
  parallelName     String?
  isAutograph      Boolean   @default(false)
  isRelic          Boolean   @default(false)
  /// The print run this parallel is numbered to, e.g. "99", or "1" for a
  /// 1-of-1 — a property of the parallel itself (SportsCardsPro's catalog
  /// encodes it in the product name). NOT the specific copy owned; see
  /// Holding.serialNumber for that.
  serialLimit      String?
  imageUrl         String?
  /// Back-of-card image, same "external reference link" convention as
  /// imageUrl — only ever a URL, never a re-hosted/uploaded copy for
  /// checklist-seeded rows (see cardType below). Rare in practice: card
  /// backs are seldom photographed except for graded high-end cards.
  imageBackUrl     String?
  /// Where imageUrl/imageBackUrl/the card's existence was verified, for
  /// attribution and so a user can double-check a checklist-seeded row.
  sourceUrl        String?
  /// True when imageUrl was inherited from this card's checklist group base
  /// row rather than being a scan of this exact printing. Parallels are
  /// seeded with the base card's photo (no per-parallel scan exists for the
  /// LaMelo checklist), which is correct about which card this is and wrong
  /// about its foil treatment — so the UI watermarks those tiles with the
  /// parallel name via components/sportscards/parallel-badge.tsx.
  imageIsInherited Boolean   @default(false)
  /// "base" | "insert" | "short_print" — set only on rows created by a
  /// checklist seed script (e.g. scripts/seed-lamelo-ball.ts), on EVERY
  /// row belonging to that checklist including each parallel (parallels
  /// are siblings sharing year/distributor/setName/cardNumber/cardType,
  /// distinguished by parallelName — same "one row per parallel" model
  /// the rest of this table already uses; see note above). Null for
  /// every card a user adds ad hoc via AddSportsCardDialog.
  cardType         String?
  /// Deterministic natural key computed at seed time (sport|year|
  /// distributor|setName|playerName|cardNumber|parallelName, lowercased),
  /// so re-running a checklist seed script upserts instead of duplicating.
  /// Null for ad hoc user-added cards, which have no such key.
  externalKey      String?   @unique
  createdAt        DateTime  @default(now())

  /// SportsCardsPro's product id, cached once resolved via search so later
  /// refreshes go straight to id lookup — same rate-limit reasoning as
  /// CatalogItem.priceChartingId. Null for cards entered fully manually
  /// with no confident catalog match (no live pricing until one is found).
  priceChartingId String? @unique

  /// Denormalized cache of the latest snapshot's ungraded price, same
  /// pattern as CatalogItem, so Portfolio totals are plain indexed reads.
  latestPriceRaw  Decimal? @db.Decimal(10, 2)
  latestPriceDate String?
  prevPriceRaw    Decimal? @db.Decimal(10, 2)
  priceChangePct  Float?

  priceSnapshots         SportsCardPriceSnapshot[]
  ebaySoldPriceSnapshots SportsCardEbaySoldPriceSnapshot[]

  @@index([sport])
  @@index([playerName])
  @@index([cardType])
  @@map("sports_card_items")
}

/// Same "current value only, snapshot once/day ourselves" pattern as
/// GradedPriceSnapshot — SportsCardsPro (PriceCharting's sister site for
/// sports cards, same API/account family) also only exposes current
/// values, not history.
model SportsCardPriceSnapshot {
  id               String         @id @default(cuid())
  sportsCardItemId String
  sportsCardItem   SportsCardItem @relation(fields: [sportsCardItemId], references: [id])
  capturedAt       DateTime       @default(now())
  capturedDate     String
  currency         String         @default("USD")

  loosePrice   Decimal? @db.Decimal(10, 2)
  grade7Price  Decimal? @db.Decimal(10, 2)
  grade8Price  Decimal? @db.Decimal(10, 2)
  grade9Price  Decimal? @db.Decimal(10, 2)
  grade95Price Decimal? @db.Decimal(10, 2)
  psa10Price   Decimal? @db.Decimal(10, 2)
  cgc10Price   Decimal? @db.Decimal(10, 2)
  sgc10Price   Decimal? @db.Decimal(10, 2)
  bgs10Price   Decimal? @db.Decimal(10, 2)
  source       String   @default("sportscardspro")

  @@unique([sportsCardItemId, capturedDate])
  @@index([sportsCardItemId, capturedAt])
  @@map("sports_card_price_snapshots")
}

/// Sports-card analogue of EbaySoldPriceSnapshot — see that model's comment
/// for why this is a separate table from SportsCardPriceSnapshot.
model SportsCardEbaySoldPriceSnapshot {
  id               String         @id @default(cuid())
  sportsCardItemId String
  sportsCardItem   SportsCardItem @relation(fields: [sportsCardItemId], references: [id])
  capturedAt       DateTime       @default(now())
  capturedDate     String
  currency         String         @default("USD")
  query            String
  count            Int
  medianPrice      Decimal?       @db.Decimal(10, 2)
  avgPrice         Decimal?       @db.Decimal(10, 2)
  minPrice         Decimal?       @db.Decimal(10, 2)
  maxPrice         Decimal?       @db.Decimal(10, 2)
  source           String         @default("ebay-sold")

  @@unique([sportsCardItemId, capturedDate])
  @@index([sportsCardItemId, capturedAt])
  @@map("sports_card_ebay_sold_price_snapshots")
}

model ShowcaseSnapshot {
  id         String   @id @default(cuid())
  /// Kept only in the publishing browser's localStorage; the credential
  /// that authorizes updating/deleting this snapshot for anonymous
  /// publishers. Still written (and still authoritative) even when userId
  /// is also set, so a snapshot published while logged in remains editable
  /// from the same browser without requiring a session.
  ownerToken String
  /// Set when the publisher was signed in at publish time. Optional and
  /// SetNull on user deletion — this snapshot is a point-in-time copy, not
  /// a live view of the user's portfolio, so it should outlive the account.
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  /// Serialized holdings + computed totals at publish time.
  payload    Json

  @@index([userId])
  @@map("showcase_snapshots")
}

/// An account. Only Credentials (email + password) auth exists today, so
/// there's no Account/Session/VerificationToken adapter tables — NextAuth
/// is configured with JWT sessions, which need no DB-backed session state.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /// Self-designated seller status, toggled from the account menu (see
  /// src/app/api/account/vendor/route.ts) — no admin approval flow exists
  /// today. Gates the Explore-area "Business mode" toggle
  /// (src/app/explore/_components/business-mode-toggle.tsx), which is the
  /// only thing this flag controls.
  isVendor     Boolean  @default(false)
  /// Per-account display preference: when true, all monetary values and
  /// pricing charts are masked app-wide for this user (see
  /// src/lib/utils/use-pricing-visible.ts). Toggled from
  /// src/app/settings/_components/settings-client.tsx.
  hidePricing  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  portfolios        Portfolio[]
  showcaseSnapshots ShowcaseSnapshot[]
  activityLogs      ActivityLog[]
  watchlistEntries  WatchlistEntry[]
  shortlistItems    ShortlistItem[]
  savedViews        SavedView[]
  curatedSets       CuratedSet[]
  decks             Deck[]

  @@map("users")
}

/// A user-facing "History" feed — one row per meaningful action a signed-in
/// user takes (search, add/remove/edit a holding, create/delete a PC,
/// toggle vendor status, publish/delete a showcase). Deliberately NOT a
/// full audit trail (no before/after diffing, no IP/UA capture) — it exists
/// so a user can scroll their own account menu > History page and recall
/// what they did, not for compliance/security review. Written by
/// src/lib/activity/log.ts, which swallows its own errors so a logging
/// failure never fails the action it's describing.
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Dot-namespaced action key, e.g. "holding.added", "holding.deleted",
  /// "pc.created", "vendor.enabled", "search.performed" — see
  /// src/lib/activity/log.ts for the full set.
  action     String
  /// Coarse grouping used by the History page's filter tabs:
  /// "holding" | "pc" | "showcase" | "vendor" | "search".
  entityType String?
  entityId   String?
  /// Pre-rendered human-readable line, e.g. "Added 2x Charizard VMAX (NM) to Main".
  summary    String
  /// Extra structured detail (query params, quantity, from/to PC, etc.) —
  /// not needed for the list view, kept for a possible future detail view.
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("activity_logs")
}

/// Server-backed portfolio ("PC" in app-facing code — see the naming-seam
/// comment atop src/lib/pc/manage.ts) for a signed-in user — the accounts
/// equivalent of the local-only PC shape in src/lib/pc/types.ts. Holding
/// ids are still generated client-side (see src/lib/pc/remote-store.ts)
/// so `id` has a server default but accepts a client-supplied value on create.
model Portfolio {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// "personal" | "business" — plain string, same "lowercase TS union,
  /// validated at the API boundary" convention as Holding.kind below.
  /// "business" marks the single auto-created "Business Inventory" PC a
  /// vendor's Explore-area "Business mode" toggle adds to — see
  /// ensureBusinessPC in src/lib/pc/remote-store.ts.
  /// Every portfolio created before this field existed is "personal" by
  /// the column default, same backfill-by-default approach as
  /// productType/language on CatalogItem above.
  kind      String    @default("personal")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  holdings  Holding[]

  @@index([userId])
  @@map("portfolios")
}

/// Server-backed equivalent of the local Holding type. kind/condition/
/// language are plain strings (not Prisma enums) because the existing
/// lowercase TS unions ("tcg", "raw", "EN") are already used by every
/// portfolio-consuming component and by holdings already persisted in
/// users' localStorage — zod validates these at the API boundary instead.
/// catalogItemId/sportsCardItemId are plain scalars, not @relations: a
/// Holding populates exactly one depending on kind (not a single relation
/// Prisma can express), and holdings are already enriched via batch
/// lookups (/api/catalog/by-ids, /api/sportscards/by-ids), not joins —
/// same zero-referential-integrity behavior the local store has today.
model Holding {
  id                 String    @id @default(cuid())
  portfolioId        String
  portfolio          Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  kind               String    @default("tcg")
  catalogItemId      String?
  sportsCardItemId   String?
  quantity           Int
  condition          String
  gradeCompany       String?
  gradeValue         String?
  /// The physical grading a "raw" (condition == "raw") holding has been
  /// assigned by its owner — one of NM/LP/MP/HP/DMG (see CARD_CONDITIONS in
  /// src/lib/constants.ts). Meaningless when condition == "graded" (that
  /// holding's condition already comes from gradeCompany/gradeValue). Same
  /// plain-String, zod-validated-at-the-boundary convention as
  /// condition/kind/language above — see the model-level comment.
  rawCondition       String?
  serialNumber       String?
  language           String    @default("EN")
  /// Free-text card name for a hand-keyed holding — set only when both
  /// catalogItemId and sportsCardItemId are null, which is otherwise an
  /// unnameable row. The only self-describing card reference in this
  /// schema: everything else resolves its name from a shared
  /// CatalogItem/SportsCardItem. Written when a user checks out a "custom"
  /// ShortlistItem (below) they keyed in at a shop counter, for a card
  /// neither catalog has. Such a holding has no market price, so
  /// enrichHoldings/computeTotals (src/lib/pc/selectors.ts) exclude it from
  /// gain/loss rather than scoring it as a total loss against $0.
  customName         String?
  costBasisTotal     Decimal   @db.Decimal(10, 2)
  costBasisCurrency  String
  /// The item's live unit market price (USD, per-unit — same convention as
  /// CatalogItem.latestPriceRaw, not quantity-scaled) at `acquiredAt`,
  /// resolved via getPriceAtDate()/getSportsCardPriceAtDate() against that
  /// date (which may be backdated, not necessarily "today"). Null when
  /// acquiredAt predates the item's oldest price snapshot, the item has no
  /// tracked price history at all, the holding predates this field, or
  /// acquiredAt itself hasn't been set yet — same "nullable denormalized
  /// cache" convention as latestPriceRaw.
  priceAtAcquisition Decimal?  @db.Decimal(10, 2)
  /// When the user physically acquired this card — distinct from
  /// `createdAt` (when the row was added to CardStory). Left null unless
  /// explicitly set by the user; no longer defaulted to "today" on add, so
  /// this stays honest for the acquisition-history feature it's meant to
  /// eventually support.
  acquiredAt         DateTime?
  /// "bought" | "traded" | "gifted" | "pack" | "other" — plain lowercase
  /// string validated by zod at the API boundary, same convention as
  /// Holding.letGoMethod above. How the card came into the collection —
  /// left null when the user hasn't set it.
  acquisitionMethod  String?
  /// Free-text: who or where the card was obtained from (a seller, a shop,
  /// a trade partner) — optional, shown regardless of acquisitionMethod,
  /// same "always visible" convention as letGoTo.
  acquiredFrom       String?
  /// Free-text elaboration on how the card ended up in the collection —
  /// only meaningful (and only shown in the UI) when acquisitionMethod is
  /// "other", same convention as letGoNotes.
  acquisitionNotes   String?
  notes              String?
  /// A photo of the specific physical card this holding represents — the
  /// owner's own copy, distinct from CatalogItem/SportsCardItem's shared
  /// reference image. Either an https:// URL or a client-resized JPEG data
  /// URL (see resizeImageToDataUrl), so plain text is enough.
  imageUrl           String?
  /// When this holding was archived (soft-deleted) out of the active
  /// collection — null means it's still active. Archiving never moves
  /// portfolioId or touches any of the acquisition fields above, so an
  /// archived row still carries its full "how it entered the collection"
  /// history intact; it's simply excluded from active PC views client-side
  /// (see holdingIsArchived in src/lib/pc/types.ts) and surfaced instead in
  /// PC Archives / Business Archives (src/components/pc/archive-client.tsx).
  archivedAt         DateTime?
  /// When the card actually left the collection — distinct from
  /// archivedAt (when the row was archived in CardStory), same relationship
  /// as acquiredAt vs createdAt above. Defaults to "now" at archive time but
  /// editable afterward, same reasoning as acquiredAt.
  letGoAt            DateTime?
  /// "sold" | "traded" | "gifted" | "lost" | "other" — plain lowercase
  /// string validated by zod at the API boundary, same convention as
  /// Holding.kind/condition above. Left null when the user archives without
  /// filling in any let-go details yet.
  letGoMethod        String?
  /// Free-text: who or what the card was passed on to (a person, a shop, a
  /// trade partner) — optional, filled in whenever the user chooses to.
  letGoTo            String?
  /// What the card was let go for, denominated in letGoCurrency (not
  /// converted to USD) — same "amount the user typed in" convention as
  /// costBasisTotal/costBasisCurrency above. Null/blank for a trade, gift,
  /// or loss with no cash amount involved.
  letGoAmount        Decimal?  @db.Decimal(10, 2)
  letGoCurrency      String?
  letGoNotes         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([portfolioId])
  @@map("holdings")
}

/// A signed-in user's watchlist entry — an item they're tracking without
/// (yet) owning, independent of any Holding. Server-backed so it follows
/// the account across devices.
model WatchlistEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "tcg" | "sports" — same lowercase-string-validated-at-the-API-boundary
  /// convention as Holding.kind. Stored explicitly (not re-derived from
  /// itemId's shape) purely for readability/debugging.
  kind   String @default("tcg")
  /// The watched item's id: a CatalogItem.id ("<gameId>:<externalId>") when
  /// kind is "tcg", or a raw SportsCardItem.id (cuid) when kind is
  /// "sports" — never a @relation, same "batch lookup, not a join"
  /// reasoning as Holding.catalogItemId/sportsCardItemId. A single
  /// always-populated column (not a nullable catalogItemId/sportsCardItemId
  /// pair like Holding) specifically so @@unique([userId, itemId]) actually
  /// enforces one-entry-per-item: Postgres treats two NULLs as distinct, so
  /// a Holding-style nullable pair couldn't prevent duplicate sports-card
  /// entries here.
  itemId String

  addedAt    DateTime @default(now())
  /// Live USD unit price at the moment this item was starred — always "now"
  /// (watchlisting is a single click, no backdating, unlike
  /// Holding.acquiredAt), so this is just the already-known client-side
  /// price captured at toggle time, never a historical lookup. Null when
  /// the item had no price yet.
  priceAtAdd Decimal? @db.Decimal(10, 2)

  @@unique([userId, itemId])
  @@index([userId])
  @@map("watchlist_entries")
}

/// A card spotted while physically shopping — the In-Store Shortlist
/// (src/app/shortlist). A maybe-purchase, not ownership and not a
/// long-term watch: it exists for the length of a trip to a shop, and ends
/// either deleted (passed on it) or checked out, which turns it into a real
/// Holding in a PC of the user's choosing. Server-backed so it survives a
/// phone dying at the counter.
///
/// Which items the user is about to buy is NOT stored here — that's a
/// decision made once, at the till, and immediately consumed by checkout,
/// so it lives as ephemeral React state (see shortlist-client.tsx) rather
/// than costing a write per checkbox tap on shop wifi.
model ShortlistItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "tcg" | "sports" | "custom" — plain lowercase string validated by zod
  /// at the API boundary, same convention as Holding.kind. Deliberately not
  /// the same union as Holding.kind/WatchlistEntry.kind: "custom" is a row
  /// the user keyed in by hand for a card neither catalog has, and there is
  /// no such thing as a custom watchlist entry.
  kind             String  @default("tcg")
  /// Populated for kind "tcg" / "sports" respectively — plain scalars, never
  /// @relations, same "batch lookup via /api/catalog/by-ids, not a join"
  /// reasoning as Holding.catalogItemId/sportsCardItemId. BOTH are null for
  /// kind "custom", which is also why this model can't borrow
  /// WatchlistEntry's single-always-populated-itemId trick.
  catalogItemId    String?
  sportsCardItemId String?
  /// kind "custom" only — the name the user typed. See Holding.customName,
  /// which this becomes at checkout.
  customName       String?
  /// kind "custom" only — optional free-text second line (set, number, etc.).
  customSubtitle   String?

  quantity Int @default(1)

  /// The shop's asking price PER UNIT, in `askingCurrency` — NOT converted
  /// to USD, unlike every market price in this schema (latestPriceRaw,
  /// priceAtAdd, priceAtAcquisition), and not quantity-scaled, unlike
  /// Holding.costBasisTotal. Same reasoning as
  /// Holding.costBasisTotal/costBasisCurrency, which this becomes verbatim
  /// at checkout: it is what a shop is charging, not a valuation, and
  /// FX_RATES_TO_USD (src/lib/constants.ts) is a static, manually refreshed
  /// table — normalising here would let a later rate edit retroactively
  /// change a price the user already paid.
  askingPrice    Decimal @db.Decimal(10, 2)
  /// ISO 4217 code from SUPPORTED_CURRENCIES, validated by zod at the API boundary.
  askingCurrency String  @default("USD")

  notes     String?
  /// Where this row was added from — "Explore", "PC · {pcName}", "Business
  /// Inventory", free text set by the button that created the row. Null for
  /// rows added the original way, straight from ShortlistAddBar/
  /// CustomItemDialog on the Shortlist page itself, which isn't tied to any
  /// card-browsing surface.
  source    String?
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Deliberately no @@unique([userId, catalogItemId]) counterpart to
  /// WatchlistEntry's: the same card at two shops at two asking prices is
  /// two legitimate rows, and comparing them is half the point of the
  /// feature.
  @@index([userId, addedAt])
  @@map("shortlist_items")
}

/// A user's saved, reusable filter/search definition over the card catalog
/// (the "Views" feature — src/app/views). Distinct from Explore's own
/// filter-bar state: ExploreFilters (src/app/explore/_components/types.ts)
/// is single-select, page-scoped, and lives only in the URL, while
/// ViewFilters (src/lib/views/types.ts) is multi-select (OR within each
/// field) and persists here. `filters` is stored as opaque Json, validated
/// against viewFiltersSchema (src/lib/views/api-schemas.ts) at the API
/// boundary before every write, so reads can trust its shape without a
/// runtime re-check.
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("saved_views")
}

/// A user's personal "chase list" — the Curated Sets feature
/// (src/app/curated-sets). Like SavedView above, `filters` is opaque Json
/// (CuratedSetFilters — src/lib/curated-sets/types.ts), validated against
/// curatedSetFiltersSchema at the API boundary before every write. Unlike a
/// View, a curated set isn't just a saved search: it's compared against the
/// user's live PC holdings (client-side, the same way CardTile computes
/// "owned" — see src/lib/curated-sets/progress.ts) to render a completion
/// percentage, so it also carries `targetQuantity` (how many copies of each
/// matching card count as "collected" — 1 for a single-copy chase, >1 for a
/// playset).
model CuratedSet {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  filters        Json
  targetQuantity Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("curated_sets")
}

/// Server-backed deck ("Deck Crafting" — src/app/deck-crafting) for a
/// signed-in user; reads/writes go through these tables via
/// src/lib/deck-crafting/store.ts.
/// Deliberately NOT following Binder's local-only-forever pattern — a deck
/// is a discrete named entity a user builds up over time and expects to
/// find again on another device, same shape as a Portfolio, not a single
/// per-browser planning tool.
model Deck {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// A src/lib/games/registry.ts game id — only "riftbound" | "fab" |
  /// "pokemon" are buildable today (see src/lib/deck-crafting/formats),
  /// but this isn't a Prisma enum so a future wired game needs no migration.
  gameId    String
  /// A src/lib/deck-crafting/formats id, e.g. "riftbound-constructed",
  /// "fab-blitz", "pokemon-standard" — looked up in the format registry to
  /// get this deck's construction rules; not a foreign key since formats
  /// are code-defined data, not a DB table (see that module's doc comment).
  formatId  String
  /// "wip" | "complete" — a plain user-set label (like Holding.kind's
  /// convention), never auto-derived from validateDeck()'s legality output:
  /// a deck can be legal and still mid-tinkering, or intentionally
  /// left incomplete.
  status    String     @default("wip")
  /// User-controlled position in their deck list — reordered via drag and
  /// drop, same "explicit user-owned ordering" idea as Holding has none of
  /// but Binder's page array relies on array order for.
  sortOrder Int        @default(0)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cards     DeckCard[]

  @@index([userId, sortOrder])
  @@map("decks")
}

/// One card-in-a-deck line. catalogItemId is a plain scalar, not a
/// @relation — same "batch lookup via /api/catalog/by-ids, not a join"
/// reasoning as Holding.catalogItemId. Whether this card is one the user
/// actually owns (the "Not Owned" watermark) is deliberately NOT stored
/// here: it's computed at read time against the user's live PC holdings
/// (src/lib/pc/selectors.ts-style derivation), so it never goes stale as
/// holdings are added/removed after the card was added to the deck.
model DeckCard {
  id            String   @id @default(cuid())
  deckId        String
  deck          Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  /// A section id from this deck's format config, e.g. "legend" |
  /// "champion" | "battlefield" | "rune" | "main" | "sideboard" | "bench"
  /// for Riftbound — see src/lib/deck-crafting/formats. Not a Prisma enum
  /// since the set of valid ids is per-format, not global.
  section       String
  catalogItemId String
  quantity      Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([deckId])
  @@map("deck_cards")
}

/// CardVision Phase 2's persistent cache of downloaded reference-card
/// images, keyed by (sourceUrl, contentHash) so identical bytes served
/// from the same (or a coincidentally identical) URL are stored once no
/// matter how many CatalogItems point at them — see
/// src/lib/cardvision/reference-index.ts. Domain-agnostic by design:
/// nothing here names a specific game, so it works the same for Pokémon,
/// MTG, sports cards, or any future CatalogItem.
///
/// This app has no R2/object-storage binding (see wrangler.jsonc) and no
/// writable local filesystem at Cloudflare Workers runtime, so this uses
/// the existing Postgres/Prisma persistence rather than a cache
/// directory. `data` is a `Bytes` (Postgres `bytea`) column — the first
/// one in this schema; every query that doesn't need to serve the actual
/// bytes should explicitly select the other columns to avoid pulling
/// image blobs into unrelated reads.
model CardReferenceImage {
  id          String   @id @default(cuid())
  /// The exact URL these bytes were fetched from. Not unique alone — see
  /// the (sourceUrl, contentHash) constraint below: a URL whose served
  /// image changes over time gets a NEW row rather than an update in
  /// place, so a stale in-flight read never sees half-written bytes
  /// (the Neon HTTP adapter this app uses has no interactive
  /// transactions — see src/lib/db.ts).
  sourceUrl   String
  /// SHA-256 hex digest of `data` — the real content identity, and how a
  /// second CatalogItem whose image URL happens to serve identical bytes
  /// gets deduped onto this same row.
  contentHash String
  data        Bytes
  contentType String
  byteSize    Int
  fetchedAt   DateTime @default(now())

  links CardReferenceImageLink[]

  @@unique([sourceUrl, contentHash])
  @@index([contentHash])
  @@map("cardvision_reference_images")
}

/// Maps one CatalogItem's reference image (large or small) to its cached
/// CardReferenceImage row. Kept separate from CardReferenceImage so N
/// CatalogItems sharing one source URL (e.g. priced-finish variants using
/// the same art) share ONE cached image instead of N copies of the bytes.
///
/// No @relation to CatalogItem: CardVision reads the catalog but never
/// wants a schema-level FK/cascade silently deleting cache rows out from
/// under an in-progress indexing run — a removed or changed CatalogItem
/// is instead detected and cleaned up explicitly by
/// CardReferenceIndexer.rebuildIndex()'s orphan sweep.
model CardReferenceImageLink {
  id     String @id @default(cuid())
  /// Existing CatalogItem.id ("<gameId>:<externalId>") — see
  /// src/lib/catalog/by-ids.ts. Always references real catalog data;
  /// never a second identity scheme.
  catalogItemId String
  gameId        String
  /// Which CatalogItem image field this link represents — "large"
  /// (preferred) or "small" (fallback), per CardReferenceIndexer's
  /// image-selection rule.
  size          String
  image         CardReferenceImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId       String
  /// The CatalogItem.imageLargeUrl/imageSmallUrl value in effect the last
  /// time this link was verified — compared against the CatalogItem's
  /// current URL on each incremental rebuildIndex() run to detect "the
  /// source URL changed since we last indexed" without re-hashing bytes.
  sourceUrlAtSync String
  lastCheckedAt   DateTime @default(now())

  @@unique([catalogItemId, size])
  @@index([gameId])
  @@index([imageId])
  @@map("cardvision_reference_image_links")
}
